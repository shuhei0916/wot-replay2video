obs:
  host: localhost
  port: 4455
  password: ""               # OBS の obs-websocket パスワード
  capture: "window"          # window: WoTウィンドウキャプチャ(前面不要) / monitor: 画面全体(前面必須)
  # exe: "C:\\Program Files\\obs-studio\\bin\\64bit\\obs64.exe"  # 自動起動に使う OBS のパス

wot:
  dir: "C:\\Games\\World_of_Tanks_ASIA"   # WoT インストール先

replays:
  dir: "G:\\path\\to\\replays"            # 処理対象リプレイの置き場（Google Drive 同期フォルダ等）
  prune:                     # 現行クライアントより古い（再生不能な）リプレイを録画前にごみ箱へ送る（src/prune_replays.py）
    enabled: false              # 佐野のように Drive 同期フォルダだと Drive からも消えるので既定は無効
                             # 戦績は output/replay_archive.jsonl に残す。web.dir も対象

batch:
  filter_enabled: true       # 録画前に戦闘結果で「見せ場のある試合」だけに絞る
  min_kills: 2               # 以下のいずれかを満たせば録画する（OR 条件）
  min_damage: 1500
  min_mastery: 3             # 3 = 1級, 4 = M章
  random_battles_only: true  # ランダム戦以外（Story Mode/Epic Random等、battleType!=1）は
                             # 成績に関わらず動画化対象から除外する

web:                         # Web 上の公開リプレイを収集して動画化する（src/collect_web.py）
  enabled: false              # true: run_batch.py が録画前に収集し、録画対象に加える
  # dir: "G:\path\to\replays_web"   # 保存先（省略時はプロジェクト内 replays/web）。台帳 collected.json もここ
  sources: [wot_record, skill4ltu]   # wot-record.com / skill4ltu.eu
  min_wn8: 4000              # この1戦 WN8 以上だけ採用（期待値表に無い新車両は不採用）
  tiers: [6, 7, 8, 9, 10, 11]
  max_downloads_per_run: 5   # 1 回の収集で採用する最大本数
  max_pages: 3               # 各サイトの新着一覧を何ページ見るか
  request_interval_sec: 5    # リクエスト間隔（サーバーに負担をかけないこと）
  own_per_web: 2             # 録画・投稿の順番: 自分のプレイ N 本につき Web 由来 1 本

preflight:
  min_free_gb: 50            # output/ のドライブの空き容量がこれ未満ならバッチを開始しない

recording:
  intro_skip:              # 開幕カウントダウンを右矢印キー(+10秒シーク)で飛ばす
    enabled: true
    presses: 2             # 送信回数（2回 = +20秒。押しすぎると戦闘序盤に食い込む）
    interval_sec: 1.2
    delay_sec: 5           # ロード完了(ReplayBattleSpace)検出からキー送信までの待ち
  require_mod: true          # mod（射撃・撃破・カメラ監視の記録）が無い録画を許さない: プリフライトで自動配置し、
                             # 録画中にイベントが出なければ録画を捨ててバッチを止める（false: CV 検出で続行）
  death_cutoff:            # 自車撃破後、grace_sec 経過で録画を打ち切る（mod の death イベント使用）
    enabled: true
    grace_sec: 20

shorts:
  max_total_sec: 150         # 1本の合計尺の上限（秒）。length_test が有効ならそちらが優先
  heat:                      # 見どころ曲線（src/heat.py）: mod v7 の記録がある録画はしきい値超えの区間を切り出す
    enabled: true            # false で従来の場面単位の選択に戻す。尺の上限（max_total_sec / length_test）は
                             # 上限として効く（超えるならしきい値を上げて絞る）
  length_test:               # 尺の A/B テスト（2026-11-27〜）: 録画ファイル名のハッシュで variants から1つ選ぶ
    enabled: true            # 視聴は尺に関係なく16〜26秒で離脱していたため、短尺と従来尺を同時期に混ぜて比べる
    variants: [40, 180]      # 2026-11-28〜: 40秒上限 vs 上限なし（180秒は YouTube Shorts の上限なので実質無制限。
                             # 見どころ曲線のしきい値だけで尺が決まる）。結果は週次レポートの「尺別の成績」で見る
  hp_overlay:                # 左下HUDのHPバーを切り出して縦動画上部に重ねる
    enabled: true
    src: { x: 3, y: 873, w: 224, h: 18 }   # 1920x1080 元フレーム内のバー矩形（HUDスケール変更時は要再計測）
    dst: { w: 874, y: 300 }                # 出力1080x1920での表示幅と上端Y（中央寄せ、高さはアスペクト比維持）
  minimap:                   # ミニマップ表示（ポジション学習用）。src は 1920x1080 元フレーム内の矩形
    enabled: true
    src: { x: 1413, y: 573, w: 507, h: 507 }   # HUD のミニマップサイズに依存（変えたら要再計測）
    first_shot:              # 最初に映る射撃の直後、ミニマップを数秒重ねる
      enabled: true
      duration_sec: 3.0
      dst: { w: 640, y: 940 }                # 出力1080x1920での幅と上端Y（中央寄せ）
    travel:                  # クリップ間の長距離移動を早送り＋ミニマップ大写しでつなぐ（mod v5 の位置記録が必要）
      enabled: true
      min_distance_m: 150
      target_sec: 3.0
      min_speed: 4
      max_speed: 16
      max_out_sec: 5.0
  dynamic_clip_length:       # 射撃間隔（reload interval）でクリップ長を可変にする
    enabled: true            # false でクリップ長固定（CLIP_PRE_SEC/CLIP_POST_SEC）に戻せる

# ffmpeg:
#   path: "C:\\ffmpeg\\bin\\ffmpeg.exe"   # PATH に無い場合のみ指定

youtube:
  enabled: true              # パイプラインからの自動アップロード
  max_per_run: 5             # upload_backlog.py が1回で上げる本数
  llm_title: false           # true: claude -p でタイトル生成 / false: テンプレート（車両, キル, ダメ, 勲章）
  privacy: "public"          # public / unlisted / private
  schedule:                  # 予約投稿: private + publishAt で上げ、YouTube が自動公開する
    enabled: true
    times: ["07:00", "12:30", "19:00"]  # JST の公開スロット（本数/日 = リスト長）
  category_id: "20"          # 20 = Gaming
  default_tags:
    - "WorldOfTanks"
    - "WoT"
    - "Shorts"
    - "戦車"
  longform:                  # 未編集フル録画をロング動画としてアップロード（upload_longform_backlog.py）
    enabled: true
    privacy: "unlisted"       # unlisted / public / private
    max_per_run: 3
    title_prefix: "【ノーカット】"

title_research:              # 他チャンネルの人気 WoT Shorts タイトルを収集（src/collect_titles.py、将来の few-shot 用）
  enabled: true               # upload_daily.bat がアップロード後に実行。台帳は output/popular_titles.json
  queries: ["World of Tanks #shorts", "WoT shorts", "ワールドオブタンクス #shorts"]  # 1語 = 100 unit（アップロードと日次クォータ共用）
  published_within_days: 30
  min_views: 10000
  max_duration_sec: 180
  interval_hours: 20
